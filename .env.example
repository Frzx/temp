MCP_HOST=0.0.0.0
MCP_PORT=3000
DORIS_HOST=172.22.248.251
DORIS_PORT=9030
DORIS_USER=your_doris_user
DORIS_PASSWORD=your_doris_password

# Authentication switches
ENABLE_TOKEN_AUTH=true
ENABLE_JWT_AUTH=false
ENABLE_OAUTH_AUTH=false
AUTH_TYPE=token

# Legacy token settings
TOKEN_SECRET=change-me
TOKEN_EXPIRY=3600

# Enhanced token authentication
TOKEN_FILE_PATH=tokens.json
ENABLE_TOKEN_EXPIRY=true
DEFAULT_TOKEN_EXPIRY_HOURS=720
TOKEN_HASH_ALGORITHM=sha256

# HTTP token management endpoints
ENABLE_HTTP_TOKEN_MANAGEMENT=true
TOKEN_MANAGEMENT_ADMIN_TOKEN=change-me-admin-token
TOKEN_MANAGEMENT_ALLOWED_IPS=127.0.0.1,::1
REQUIRE_ADMIN_AUTH=true

# Optional built-in default tokens
DEFAULT_ADMIN_TOKEN=change-me-default-admin-token
DEFAULT_ADMIN_DESCRIPTION=Default admin API access token
DEFAULT_ANALYST_TOKEN=change-me-default-analyst-token
DEFAULT_ANALYST_DESCRIPTION=Default data analysis API access token
DEFAULT_READONLY_TOKEN=change-me-default-readonly-token
DEFAULT_READONLY_DESCRIPTION=Default read-only API access token

# Optional custom tokens loaded from environment
# TOKEN_AGENT_1=change-me-agent-token
# TOKEN_AGENT_1_EXPIRES_HOURS=24
# TOKEN_AGENT_1_DESCRIPTION=Agent token for testing

# JWT auth example
# For a JWT-only setup, flip the switches below and provide either
# RS256 key paths, RS256 key env vars, or an HS256 secret.
# Start the server with: python run_jwt_server.py --transport http
#
# ENABLE_TOKEN_AUTH=false
# ENABLE_JWT_AUTH=true
# ENABLE_OAUTH_AUTH=false
# AUTH_TYPE=jwt
#
# JWT_ALGORITHM=RS256
# JWT_ISSUER=https://login.example.com
# JWT_AUDIENCE=doris-mcp-client
# JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
# JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
#
# Or for HS256 local testing:
# JWT_ALGORITHM=HS256
# JWT_SECRET_KEY=replace-with-a-long-random-secret
#
# Optional validation controls
# JWT_VERIFY_SIGNATURE=true
# JWT_VERIFY_AUDIENCE=true
# JWT_VERIFY_ISSUER=true
# JWT_REQUIRE_IAT=true
# JWT_REQUIRE_EXP=true
# JWT_REQUIRE_NBF=false
# JWT_LEEWAY=10
